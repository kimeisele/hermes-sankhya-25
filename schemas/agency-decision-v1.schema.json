{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-sankhya-25/agency-decision-v1.schema.json",
  "title": "AgencyDecisionV1",
  "type": "object",
  "required": ["decision_id", "disposition", "timestamp", "director_run_id"],
  "properties": {
    "decision_id": {"type": "string"},
    "disposition": {"type": "string", "enum": ["NOOP", "RECORD_ONLY", "PROPOSE_ENGAGEMENT", "PROPOSE_ENGINEERING_INTAKE", "READY_FOR_SYNTHESIS", "ESCALATE_TO_HUMAN"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "director_run_id": {"type": "string"},
    "rationale": {"type": "string"},
    "next_role": {"type": "string"},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "risk_assessment": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "synthesis": {
      "type": "object",
      "required": ["inquiry", "executive_answer", "findings", "unresolved_questions", "next_inquiry"],
      "properties": {
        "inquiry": {"type": "string"},
        "executive_answer": {"type": "string"},
        "findings": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": ["finding_id", "statement", "source_ids", "confidence", "reasoning"],
            "properties": {
              "finding_id": {"type": "string"},
              "statement": {"type": "string"},
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "confidence": {"type": "string", "enum": ["observed", "supported", "inferred", "unknown"]},
              "reasoning": {"type": "string"}
            }
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "next_inquiry": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"disposition": {"const": "READY_FOR_SYNTHESIS"}},
        "required": ["disposition"]
      },
      "then": {
        "required": ["synthesis"]
      }
    }
  ]
}
